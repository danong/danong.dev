#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: ./scripts/jj-ship [REVISION]

Push a Jujutsu change to a new ship/* bookmark, open a PR against main, and
wait for its checks to pass before squash-merging it.

When REVISION is omitted, ships @ if it is non-empty, otherwise @-.
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if (( $# > 1 )); then
  usage >&2
  exit 2
fi

for dependency in jj gh git; do
  if ! command -v "$dependency" >/dev/null 2>&1; then
    printf 'Required command not found: %s\n' "$dependency" >&2
    exit 1
  fi
done

gh auth status >/dev/null
jj git fetch --remote origin

revision="${1:-}"
if [[ -z "$revision" ]]; then
  if [[ "$(jj log --no-graph -r @ -T 'empty')" == "true" ]]; then
    revision='@-'
  else
    revision='@'
  fi
fi

description="$(jj log --no-graph -r "$revision" -T 'description')"
if [[ -z "${description//[[:space:]]/}" ]]; then
  printf 'Revision %s has no description. Set one with `jj describe` or pass another revision.\n' "$revision" >&2
  exit 1
fi

title="${description%%$'\n'*}"
if [[ "$title" == *'\n'* ]]; then
  title="${title%%'\n'*}"
fi
change_id="$(jj log --no-graph -r "$revision" -T 'change_id.short()')"
bookmark="ship/${change_id}"

working_copy_id="$(jj log --no-graph -r @ -T 'change_id')"
working_copy_empty="$(jj log --no-graph -r @ -T 'empty')"
parent_change_id="$(jj log --no-graph -r @- -T 'change_id')"
target_commit="$(jj log --no-graph -r "$revision" -T 'commit_id')"
reset_to_main=false
if [[ "$change_id" == "$working_copy_id" ]] || \
  [[ "$working_copy_empty" == true && "$change_id" == "$parent_change_id" ]]; then
  reset_to_main=true
fi

if [[ -n "$(jj bookmark list --all-remotes "$bookmark" 2>/dev/null)" ]]; then
  jj bookmark set "$bookmark" --revision "$revision"
else
  jj bookmark create "$bookmark" --revision "$revision"
fi
jj git push --remote origin --bookmark "$bookmark"

origin_url="$(git remote get-url origin)"
repo="${origin_url#git@github.com:}"
repo="${repo#https://github.com/}"
repo="${repo#ssh://git@github.com/}"
repo="${repo%.git}"
if [[ "$repo" != */* || "$repo" == */*/* ]]; then
  printf 'Cannot determine GitHub owner/repository from origin URL: %s\n' "$origin_url" >&2
  exit 1
fi

pr_url="$(gh pr list --repo "$repo" --state open --head "$bookmark" --json url --jq '.[0].url // empty')"
if [[ -z "$pr_url" ]]; then
  body="$(printf 'Automated PR for Jujutsu change `%s`.\n\nRequired checks must pass before GitHub merges this PR.' "$change_id")"
  pr_url="$(gh api "repos/${repo}/pulls" --method POST -f title="$title" -f head="$bookmark" -f base=main -f body="$body" --jq '.html_url')"
fi

checks_ready=false
for attempt in {1..12}; do
  if checks_output="$(gh pr checks "$pr_url" --repo "$repo" --watch 2>&1)"; then
    printf '%s\n' "$checks_output"
    checks_ready=true
    break
  else
    checks_status=$?
  fi

  if [[ "$checks_output" != *"no checks reported"* ]]; then
    printf '%s\n' "$checks_output" >&2
    exit "$checks_status"
  fi
  sleep 5
done

if [[ "$checks_ready" != true ]]; then
  printf 'No checks were reported for %s after waiting.\n' "$pr_url" >&2
  exit 1
fi

gh pr merge "$pr_url" --repo "$repo" --squash

git push origin --delete "$bookmark"
jj bookmark delete "$bookmark"
jj git fetch --remote origin

if [[ "$reset_to_main" == true ]]; then
  jj new main
  merged_revisions="main..${target_commit}"
  if [[ -n "$(jj log --no-graph -r "$merged_revisions" -T 'commit_id')" ]] &&
    [[ -z "$(jj bookmark list --all-remotes -r "$merged_revisions")" ]]; then
    jj abandon "$merged_revisions"
  fi
fi

printf 'PR: %s\n' "$pr_url"
