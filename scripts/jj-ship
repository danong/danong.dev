#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: ./scripts/jj-ship [REVISION]

Push a Jujutsu change to a new ship/* bookmark, open a PR against main, and
enable GitHub auto-merge so it merges when required checks pass.

When REVISION is omitted, ships @ if it is non-empty, otherwise @-.
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if (( $# > 1 )); then
  usage >&2
  exit 2
fi

for dependency in jj gh; do
  if ! command -v "$dependency" >/dev/null 2>&1; then
    printf 'Required command not found: %s\n' "$dependency" >&2
    exit 1
  fi
done

revision="${1:-}"
if [[ -z "$revision" ]]; then
  if [[ "$(jj log -r @ -T 'empty')" == "true" ]]; then
    revision='@-'
  else
    revision='@'
  fi
fi

description="$(jj log -r "$revision" -T 'description')"
if [[ -z "${description//[[:space:]]/}" ]]; then
  printf 'Revision %s has no description. Set one with `jj describe` or pass another revision.\n' "$revision" >&2
  exit 1
fi

title="${description%%$'\n'*}"
change_id="$(jj log -r "$revision" -T 'change_id')"
short_id="${change_id:0:8}"
slug="$(printf '%s' "$title" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-|-$//g' | cut -c1-40 | sed 's/-$//')"
if [[ -z "$slug" ]]; then
  slug='change'
fi
bookmark="ship/${slug}-${short_id}"

gh auth status >/dev/null
jj git fetch --remote origin

if jj bookmark list "$bookmark" 2>/dev/null | grep -q .; then
  printf 'Bookmark already exists: %s\n' "$bookmark" >&2
  printf 'Pass a different revision or remove that bookmark before shipping.\n' >&2
  exit 1
fi

jj bookmark create "$bookmark" --revision "$revision"
jj git push --remote origin --bookmark "$bookmark"

pr_url="$(gh pr list --state open --head "$bookmark" --json url --jq '.[0].url // empty')"
if [[ -z "$pr_url" ]]; then
  body="$(printf 'Automated PR for Jujutsu change `%s`.\n\nRequired checks must pass before GitHub merges this PR.' "$change_id")"
  pr_url="$(gh pr create --base main --head "$bookmark" --title "$title" --body "$body")"
fi

gh pr merge "$pr_url" --auto
printf 'PR: %s\n' "$pr_url"
